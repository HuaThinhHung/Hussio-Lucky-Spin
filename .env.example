# ---------------------------------------------------------------------------
# HUSSIO Lucky Spin — environment variables
# Copy to `.env` for local development. On Vercel, set these in
# Project Settings -> Environment Variables. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local (npm run db:local): postgresql://postgres:postgres@127.0.0.1:5544/hussio_lucky_spin
# Production: Vercel Postgres / Neon / Supabase pooled URL with sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5544/hussio_lucky_spin"

# Public URL of this app (used for links, origin checks, webhook URL display).
APP_URL="http://localhost:3000"
# Shopify storefront (CTA "MUA SẮM TẠI HUSSIO").
NEXT_PUBLIC_SHOP_URL="https://hussio.com"

# --- Security -------------------------------------------------------------
# Random 32+ char strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
# Pepper for hashing customer phone numbers. DO NOT change after codes are
# issued, otherwise existing codes can no longer be verified.
PHONE_HASH_SECRET="change-me-to-another-long-random-string"

# First admin account, created by `npm run db:seed` (only if it doesn't exist).
# Leave ADMIN_PASSWORD empty to generate a random one (printed once in the console).
ADMIN_EMAIL="admin@hussio.com"
ADMIN_PASSWORD=""

# --- Shopify (MERCHANT FILLS IN LATER) -------------------------------------
# Leave empty to run in MOCK mode: everything works, but vouchers are not
# created on Shopify and website orders must be entered manually.
#
# Store domain, e.g. "hussio.myshopify.com" (NOT hussio.com).
SHOPIFY_SHOP_DOMAIN=""
SHOPIFY_API_VERSION="2026-10"
# Dev Dashboard app credentials (Client ID / Client secret). Used for the
# client-credentials grant (token auto-refreshed every 24h).
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Optional: a static Admin API access token (shpat_...). If set, it is used
# instead of the client-credentials grant.
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# Secret used to verify webhook HMAC. For apps from the Dev Dashboard this is
# the app Client secret; for webhooks created in Shopify admin
# (Settings -> Notifications -> Webhooks) use the key shown on that page.
SHOPIFY_WEBHOOK_SECRET=""
# Write a tag + metafield (hussio.lucky_code) on eligible Shopify orders.
SHOPIFY_WRITE_ORDER_TAGS="false"
